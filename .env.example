# Rencana konfigurasi Docker Compose.
# Belum digunakan sampai Docker Compose diimplementasikan.
# Jangan masukkan kredensial aktual ke file contoh ini.

COMPOSE_PROJECT_NAME=orderly

APP_NAME="Orderly API"
APP_ENV=local
APP_DEBUG=true
APP_KEY=
APP_URL=http://localhost:8000

# Host dan port INTERNAL jaringan Docker Compose.
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=orderly_dev
DB_USERNAME=orderly_app
DB_PASSWORD=

# Port yang nantinya tersedia dari host.
BACKEND_PORT=8000
FRONTEND_PORT=8080
DB_FORWARD_PORT=55432

# Konfigurasi publik untuk frontend, bukan tempat secrets.
VITE_API_URL=/api
