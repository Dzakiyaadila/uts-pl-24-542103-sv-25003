# Contoh konfigurasi Docker Compose. Salin menjadi .env dan isi rahasia secara lokal.
# Jangan commit file .env aktual.

COMPOSE_PROJECT_NAME=orderly

APP_NAME="Orderly API"
APP_ENV=local
APP_DEBUG=true
APP_KEY=
APP_URL=http://localhost:8080

# Alamat internal jaringan Compose.
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=orderly_dev
DB_USERNAME=orderly_app
DB_PASSWORD=

# Port frontend yang dapat diakses dari Mac.
FRONTEND_PORT=8080

# URL API publik untuk build Vue; tidak boleh berisi rahasia.
VITE_API_URL=/api
